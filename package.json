{
  "name": "video-maker",
  "version": "0.6.1",
  "description": "Video Maker - Professional video creation tool",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint . --ext .js",
    "test": "playwright test",
    "e2e": "playwright test",
    "dist": "electron-builder --publish=never",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "@playwright/test": "^1.44.0",
    "playwright": "^1.44.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "zod": "^3.22.4"
  },
  "build": {
    "appId": "com.videomaker.app",
    "productName": "Video Maker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "**/ffprobe*",
      "**/ffprobe-static/**",
      "**/ffmpeg*",
      "**/ffmpeg-static/**",
      "app/assets/fonts/**"
    ]
  }
}